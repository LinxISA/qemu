#
# LinxISA 32-bit instruction decoding
#
# This file contains the 32-bit instruction forms implemented by
# target/linx/translate.c.
#

# Fields
%RegDst 7:5
%SrcL 15:5
%SrcR 20:5
%SrcZero 20:5
%SrcRType 25:2
%SrcD 27:5
%SrcP 27:5
%SrcA 27:5
%DstType 27:5
%SrcType 25:2
%imm4 24:4
%imm20 12:20
%simm17 15:s17
%simm22 7:s5 15:17
%simm25 7:s25
%uimm12 20:12
%simm12_20_s12 20:s12
%simm12_7_s5_25_7 7:s5 25:7
%shamt_27_5 27:5
%shamt_20_6 20:6
%shamt_20_5 20:5
%imml 20:6
%imms 26:6
%immr 26:6
%uimm17_20_12_7_5 20:12 7:5
%lb_dst 12:3
%ssr_id 20:12
%lsr_id 20:12
%acr_type 20:4
%aq 26:1
%rl 25:1
%far 27:1
%pred_imm 24:4
%succ_imm 20:4
%ModeHi 26:1
%Mode 25:2

# Canonical v0.56.5 control/data attribute fields
%BA_DR 26:1
%BA_aq 29:1
%BA_atom 30:1
%BA_far 27:1
%BA_rl 28:1
%BA_trap 31:1
%BA_CMode 25:3
%BA_DataLayout 7:5
%BA_DataType 20:5
%BA_PadValue 15:5
%BA_RMode 28:3
%BA_Sat 31:1

# Block hint (B.HINT) fields
%HINT_L_UL 16:1
%HINT_V 15:1
%HINT_temp 17:2
%HINT_prefetch_size 20:12
%HINT_B_E 15:1

# Tile block fields
%TileDataType 27:5
%TileFunc 20:5
%TileOp10 15:10
%TileDst 25:3
%TileSrc0 15:5
%TileSrc1 20:5
%TileRegSrc 7:5
%TileSize 7:5
%TileFormat 7:5
%TileGroup 12:1
%S1R 31:1
%S0R 30:1
%S1V 29:1
%S0V 28:1
%IOTDstTile 22:3
%IOTL 29:1
%IOTS0R 30:1
%IOTS1R 31:1
%IOTSrc0 15:1 7:5
%IOTSrc1 16:6
%IOTImm4 25:4

# Block headers
bstart_split_direct .... .... .... .... .... .... .001 0001 %simm25
bstart_split_cond   .... .... .... .... .... .... .010 0001 %simm25
bstart_fall   .... .... .... .... .001 0000 0000 0001 %simm17
bstart_direct .... .... .... .... .010 0000 0000 0001 %simm17
bstart_cond   .... .... .... .... .011 0000 0000 0001 %simm17
bstart_call   .... .... .... .... .100 0000 0000 0001 %simm17
bstart_ind    0000 0000 0000 0000 0101 0000 0000 0001
bstart_icall  0000 0000 0000 0000 0110 0000 0000 0001
bstart_ret    0000 0000 0000 0000 0111 0000 0000 0001
bstart_fp_fall    .... .... .... .... .001 0001 0000 0001 %simm17
bstart_fp_direct  .... .... .... .... .010 0001 0000 0001 %simm17
bstart_fp_cond    .... .... .... .... .011 0001 0000 0001 %simm17
bstart_fp_call    .... .... .... .... .100 0001 0000 0001 %simm17
bstart_fp_ind     0000 0000 0000 0000 0101 0001 0000 0001
bstart_fp_icall   0000 0000 0000 0000 0110 0001 0000 0001
bstart_fp_ret     0000 0000 0000 0000 0111 0001 0000 0001
bstart_sys        .... .... .... .... .001 0000 1000 0001 %simm17
bstart_fixp       .... .00. .... 0011 1001 0001 1000 0001 dtype=%TileDataType func=%TileFunc
bstart_tepl       .... .01. .... .... .001 0001 1000 0001 dtype=%TileDataType op=%TileOp10
bstop         0000 0000 0000 0000 0000 0000 0000 0001

# Vector block headers (VPAR/VSEQ). These are fall-through blocks that commit at
# (C.)BSTOP or when the next BSTART is encountered.
bstart_vpar 0000 0.00 0000 0010 0001 0001 1000 0001 mode=%ModeHi
bstart_vseq 0000 0.00 0000 0010 1001 0001 1000 0001 mode=%ModeHi

# Vector block headers for memory operations (MSEQ/MPAR).
# MSEQ: sequential vector execution with memory access
bstart_mseq 0000 0.00 0000 0000 1001 0001 1000 0001 mode=%ModeHi
# MPAR: parallel vector execution with memory access
bstart_mpar 0000 0.00 0000 0000 0001 0001 1000 0001 mode=%ModeHi

# Tile block headers (TMA/CUBE). These are fall-through blocks that commit at
# (C.)BSTOP or when the next BSTART is encountered.
bstart_tma     .... .00. .... 0001 0001 0001 1000 0001 dtype=%TileDataType func=%TileFunc
bstart_cube    .... .00. .... 0011 0001 0001 1000 0001 dtype=%TileDataType func=%TileFunc

# Tile block I/O dependency descriptors (multiple descriptors per block are legal).
b_iot          .... .... .... .... .100 .... .001 0011 dst=%IOTDstTile l=%IOTL s0r=%IOTS0R s1r=%IOTS1R src0=%IOTSrc0 src1=%IOTSrc1 imm4=%IOTImm4
b_iot          0... .... ..00 0000 .101 .... .001 0011 dst=%IOTDstTile l=%IOTL s0r=%IOTS0R s1r=0 src0=%IOTSrc0 src1=0 imm4=%IOTImm4
b_iot          00.. .... ..00 0000 0110 0000 0001 0011 dst=%IOTDstTile l=%IOTL s0r=0 s1r=0 src0=0 src1=0 imm4=%IOTImm4

# Decoupled-body pointer (decoupled block headers).
b_text         .... .... .... .... .... .... .000 0011 %simm25

# GPR I/O dependency (decoupled block headers).
b_ior          .... .00. .... .... .000 .... .001 0011 %RegDst %SrcL %SrcR %SrcD

# Tile/tensor layout selector for descriptor-rich TLOAD/TSTORE headers.
b_arg          0000 0000 0000 0000 0011 .... .100 0011 format=%TileFormat
b_arg_norm     0000 0000 0000 1111 1010 0000 0010 0011
b_arg_nz2dn    0000 0010 0000 1111 1010 1110 0010 0011
b_arg_nd2zn    0001 1000 0000 0010 0010 0001 1010 0011
b_arg_dn2nz    0001 1000 0000 0000 1010 0100 1010 0011
b_arg_dn2zn    0001 1000 0000 0010 0010 0100 0010 0011

# Block attributes (ordering/traps); treated as hints/no-ops in bring-up.
b_catr         .... ..00 0000 0000 0000 0000 0010 0011 dr=%BA_DR aq=%BA_aq atom=%BA_atom far=%BA_far rl=%BA_rl trap=%BA_trap
b_datr         .... .... .... .... .001 .... .010 0011 cmode=%BA_CMode layout=%BA_DataLayout dtype=%BA_DataType pad=%BA_PadValue rmode=%BA_RMode sat=%BA_Sat

# Block hints; treated as no-ops in bring-up.
b_hint         .... .... .... 0... .000 0000 0011 0011 l_ul=%HINT_L_UL v=%HINT_V prefetch_size=%HINT_prefetch_size temp=%HINT_temp
b_hint_trace   0000 0000 0000 0000 .001 0000 0011 0011 b_e=%HINT_B_E
# Block argument registers (LB0/LB1/LB2): LBx = RegSrc + uimm17
b_dim_lb0      .... .... .... .... .000 .... .100 0011 reg=%SrcL uimm=%uimm17_20_12_7_5
b_dim_lb1      .... .... .... .... .001 .... .100 0011 reg=%SrcL uimm=%uimm17_20_12_7_5
b_dim_lb2      .... .... .... .... .010 .... .100 0011 reg=%SrcL uimm=%uimm17_20_12_7_5

# SSR access (system registers)
# Encoding (base form): SSR_ID[11:0] in bits [31:20].
ssrget .... .... .... 0000 0000 .... .011 1011 %RegDst ssrid=%ssr_id
ssrset .... .... .... .... .001 0000 0011 1011 %SrcL ssrid=%ssr_id
ssrswap .... .... .... .... .010 .... .011 1011 %RegDst %SrcL ssrid=%ssr_id

# Access Control Ring (ACR) privilege transitions
# acrc rst_type
acrc   0000 0000 .... 0000 0011 0000 0010 1011 rst=%acr_type
# acre rra_type
acre   0000 0001 .... 0000 0011 0000 0010 1011 rra=%acr_type

# Atomics (minimal subset for toolchain intrinsics bring-up)
# Field mapping matches isa/spec: far/aq/rl plus (SrcL/SrcR/RegDst) and funct3.
lr_w   0010 ...0 0000 .... .000 .... .000 1011 %RegDst %SrcL far=%far aq=%aq rl=%rl
lr_d   0011 ...0 0000 .... .000 .... .000 1011 %RegDst %SrcL far=%far aq=%aq rl=%rl
sc_w   0010 .... .... .... .001 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl
sc_d   0011 .... .... .... .001 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl

swapw  0010 .... .... .... .110 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl
swapd  0011 .... .... .... .110 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl

lw_add 0000 .... .... .... .010 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl
ld_add 0000 .... .... .... .100 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl

fence_d 0000 .... .... 0000 0010 0000 0010 1011 pred=%pred_imm succ=%succ_imm
fence_i 0001 0000 0000 0000 0010 0000 0010 1011

# TLB flush (bring-up).
tlb_ia   0000 0000 0000 .... .111 0000 0010 1011 %SrcL
tlb_iv   0000 0000 0001 .... .111 0000 0010 1011 %SrcL
tlb_iav  0000 0000 0010 .... .111 0000 0010 1011 %SrcL
tlb_iall 0000 0000 0011 0000 0111 0000 0010 1011

# Function entry/exit macro instructions (LinxISA spec)
# These encode register range [SrcBegin ~ SrcEnd] and stack size (uimm)
#
# Encoding:
#   bits [6:0] = 0x41 (opcode)
#   bits [11:7] = uimm[14:10] (high 5 bits of stack size / 8)
#   bits [14:12] = type (000=FENTRY, 001=FEXIT, 010=FRET.RA, 011=FRET.STK)
#   bits [19:15] = SrcBegin/DstBegin (start register index)
#   bits [24:20] = SrcEnd/DstEnd (end register index)
#   bits [31:25] = uimm[9:3] (low 7 bits of stack size / 8)
#
# Stack size = uimm (8-byte aligned, uimm[2:0] implicit 0)
# Register range: R[Begin] to R[End], can wrap around R23->R2
%fentry_uimm_hi 7:5
%fentry_uimm_lo 25:7
%fentry_begin 15:5
%fentry_end 20:5

# FENTRY: Function entry - save registers, adjust SP
fentry        .... .... .... .... .000 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FEXIT: Function exit - restore registers, adjust SP (returns via setc.tgt)
fexit         .... .... .... .... .001 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FRET.RA: Function return via RA - restore registers, adjust SP, return
fret_ra       .... .... .... .... .010 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FRET.STK: Function return via stack - restore registers, adjust SP, return
fret_stk      .... .... .... .... .011 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# Bulk memory template blocks (restartable).
# Encoding per spec:
#   MCOPY: RegSrc0=DstAddr (bits 19..15), RegSrc1=SrcAddr (24..20), RegSrc2=Size (31..27)
#   MSET:  RegSrc0=DstAddr (bits 19..15), RegSrc1=Value   (24..20), RegSrc2=Size (31..27)
# These are standalone template blocks (must not appear inside BSTART..BSTOP).
mcopy         .... .00. .... .... .000 0000 0011 0001 %SrcL %SrcR %SrcD
mset          .... .00. .... .... .001 0000 0011 0001 %SrcL %SrcR %SrcD
esave         .... .00. .... .... .010 0000 0011 0001 %SrcL %SrcR %SrcD
ercov         .... .00. .... .... .011 0000 0011 0001 %SrcL %SrcR %SrcD

# PC-relative address instructions (overlap group - setret is specialized addtpc with RegDst=RA)
{
  setret        .... .... .... .... .... 0101 0000 0111 %imm20
  addtpc        .... .... .... .... .... .... .000 0111 %RegDst %imm20
}

# Call/return support
setc_tgt      0000 0000 0000 .... .100 0000 0011 1011 %SrcL

# Predicate/compare
setc_eq       0000 0... .... .... .000 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_eqi      .... .... .... .... .000 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_ne       0000 0... .... .... .001 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_nei      .... .... .... .... .001 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_and      0000 0... .... .... .010 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_andi     .... .... .... .... .010 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_or       0000 0... .... .... .011 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_ori      .... .... .... .... .011 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_lt       0000 0... .... .... .100 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_lti      .... .... .... .... .100 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_ltu      0000 0... .... .... .110 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_ltui     .... .... .... .... .110 .... .111 0101 %SrcL %uimm12 shamt=%RegDst
setc_ge       0000 0... .... .... .101 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_gei      .... .... .... .... .101 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_geu      0000 0... .... .... .111 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_geui     .... .... .... .... .111 .... .111 0101 %SrcL %uimm12 shamt=%RegDst

cmp_eq        0000 0... .... .... .000 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_ne        0000 0... .... .... .001 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_and       0000 0... .... .... .010 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_or        0000 0... .... .... .011 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_lt        0000 0... .... .... .100 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_ge        0000 0... .... .... .101 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_ltu       0000 0... .... .... .110 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_geu       0000 0... .... .... .111 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType

# Compare-and-branch
b_eq          .... .... .... .... .000 .... .010 0111 %SrcL %SrcR simm12=%simm12_7_s5_25_7
b_ne          .... .... .... .... .001 .... .010 0111 %SrcL %SrcR simm12=%simm12_7_s5_25_7
b_lt          .... .... .... .... .010 .... .010 0111 %SrcL %SrcR simm12=%simm12_7_s5_25_7
b_ge          .... .... .... .... .011 .... .010 0111 %SrcL %SrcR simm12=%simm12_7_s5_25_7
b_ltu         .... .... .... .... .100 .... .010 0111 %SrcL %SrcR simm12=%simm12_7_s5_25_7
b_geu         .... .... .... .... .101 .... .010 0111 %SrcL %SrcR simm12=%simm12_7_s5_25_7

csel          .... .... .... .... .000 .... .111 0111 %RegDst %SrcL %SrcP %SrcR %SrcRType

# ALU (register)
add           .... .... .... .... .000 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
sub           .... .... .... .... .001 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
and           .... .... .... .... .010 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
or            .... .... .... .... .011 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
xor           .... .... .... .... .100 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5

addw          .... .... .... .... .000 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
subw          .... .... .... .... .001 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
andw          .... .... .... .... .010 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
orw           .... .... .... .... .011 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
xorw          .... .... .... .... .100 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5

