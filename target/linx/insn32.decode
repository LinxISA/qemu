#
# LinxISA 32-bit instruction decoding
#
# This file contains the 32-bit instruction forms implemented by
# target/linx/translate.c.
#

# Fields
%RegDst 7:5
%SrcL 15:5
%SrcR 20:5
%SrcZero 20:5
%SrcRType 25:2
%SrcD 27:5
%SrcP 27:5
%SrcA 27:5
%DstType 27:5
%SrcType 25:2
%imm4 24:4
%imm20 12:20
%simm17 15:s17
%simm22 7:s5 15:17
%simm25 7:s25
%fused_call_simm12 4:s12
%fused_call_uimm5 22:5
%uimm12 20:12
%simm12_20_s12 20:s12
%simm12_7_s5_25_7 7:s5 25:7
%shamt_27_5 27:5
%shamt_20_6 20:6
%shamt_20_5 20:5
%imml 20:6
%imms 26:6
%immr 26:6
%uimm17_20_12_7_5 20:12 7:5
%lb_dst 12:3
%ssr_id 20:12
%lsr_id 20:12
%acr_type 20:4
%aq 26:1
%rl 25:1
%far 27:1
%pred_imm 24:4
%succ_imm 20:4
%ModeHi 26:1
%Mode 25:2
%XBRaw 15:17

# Canonical v0.57 control/data attribute fields
%BA_DR 26:1
%BA_aq 16:1
%BA_atom 17:1
%BA_far 18:1
%BA_rl 15:1
%BA_trap 19:1
%BA_CMode 29:3
%BA_DataLayout 7:5
%BA_DataType 20:5
%BA_PadValue 27:2
%BA_RMode 15:3
%BA_Sat 26:1
%BA_Canonicalize 25:1
%FP_PreQuantMode 26:6
%FP_ReluMode 23:3
%FP_GroupNCode 19:4
%FP_RowMaxEn 18:1
%FP_GroupMaxEn 17:1
%FP_RowMaxInit 16:1
%FP_MaxAbsEn 15:1

# Block hint (B.HINT) fields
%HINT_L_UL 16:1
%HINT_V 15:1
%HINT_temp 17:2
%HINT_prefetch_size 20:12
%HINT_B_E 15:1

# Tile block fields
%TileDataType 27:5
%TileFunc 20:5
%TileDst 25:3
%TileSrc0 15:5
%TileSrc1 20:5
%TileRegSrc 7:5
%TileSize 7:5
%TileFormat 7:5
%TileGroup 12:1
%S1R 31:1
%S0R 30:1
%S1V 29:1
%S0V 28:1
%IOTV5Src1 26:6
%IOTV5Src0 20:6
%IOTV5Last 19:1
%IOTV5PeMask 15:4
%IOTV5TSize 9:3
%IOTV5Dst 7:2

# Block headers
bstart_split_direct .... .... .... .... .... .... .001 0001 %simm25
bstart_split_cond   .... .... .... .... .... .... .010 0001 %simm25
# Atomic 16+16 BSTART.CALL. Runtime fetch recognizes the complete word before
# dispatch because the low halfword uses the compressed length prefix.
start_call_32 0101 0... ..01 0110 .... .... .... 0010 simm12=%fused_call_simm12 uimm5=%fused_call_uimm5
bstart_fall   .... .... .... .... .001 0000 0000 0001 %simm17
bstart_direct .... .... .... .... .010 0000 0000 0001 %simm17
bstart_cond   .... .... .... .... .011 0000 0000 0001 %simm17
bstart_call   .... .... .... .... .100 0000 0000 0001 %simm17
bstart_ind    0000 0000 0000 0000 0101 0000 0000 0001
bstart_icall  0000 0000 0000 0000 0110 0000 0000 0001
bstart_ret    0000 0000 0000 0000 0111 0000 0000 0001
bstart_fp_fall    .... .... .... .... .001 0001 0000 0001 %simm17
bstart_fp_direct  .... .... .... .... .010 0001 0000 0001 %simm17
bstart_fp_cond    .... .... .... .... .011 0001 0000 0001 %simm17
bstart_fp_call    .... .... .... .... .100 0001 0000 0001 %simm17
bstart_fp_ind     0000 0000 0000 0000 0101 0001 0000 0001
bstart_fp_icall   0000 0000 0000 0000 0110 0001 0000 0001
bstart_fp_ret     0000 0000 0000 0000 0111 0001 0000 0001
bstart_sys        .... .... .... .... .001 0000 1000 0001 %simm17
