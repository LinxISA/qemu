  bstart_tcolexpandexpdif     .... .101 1011 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_texpands             .... .011 1011 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tci                  .... .110 0110 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_ttri                 .... .110 0111 0001 1001 0001 1000 0001 dtype=%TileDataType
