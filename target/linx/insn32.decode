#
# LinxISA 32-bit instruction decoding
#
# This file contains the 32-bit instruction forms implemented by
# target/linx/translate.c.
#

# Fields
%RegDst 7:5
%SrcL 15:5
%SrcR 20:5
%SrcRType 25:2
%SrcD 27:5
%SrcP 27:5
%SrcA 27:5
%imm4 24:4
%imm20 12:20
%simm17 15:s17
%simm22 7:s5 15:17
%simm25 7:s25
%uimm12 20:12
%simm12_20_s12 20:s12
%simm12_7_s5_25_7 7:s5 25:7
%shamt_27_5 27:5
%shamt_20_6 20:6
%shamt_20_5 20:5
%imml 20:6
%imms 26:6
%immr 26:6

# Block headers
bstart_direct .... .... .... .... .010 0000 0000 0001 %simm17
bstart_cond   .... .... .... .... .011 0000 0000 0001 %simm17
bstart_call   .... .... .... .... .100 0000 0000 0001 %simm17

# Function entry/exit macro instructions (LinxISA spec)
# These encode register range [SrcBegin ~ SrcEnd] and stack size (uimm)
#
# Encoding:
#   bits [6:0] = 0x41 (opcode)
#   bits [11:7] = uimm[14:10] (high 5 bits of stack size / 8)
#   bits [14:12] = type (000=FENTRY, 001=FEXIT, 010=FRET.RA, 011=FRET.STK)
#   bits [19:15] = SrcBegin/DstBegin (start register index)
#   bits [24:20] = SrcEnd/DstEnd (end register index)
#   bits [31:25] = uimm[9:3] (low 7 bits of stack size / 8)
#
# Stack size = uimm (8-byte aligned, uimm[2:0] implicit 0)
# Register range: R[Begin] to R[End], can wrap around R23->R2
%fentry_uimm_hi 7:5
%fentry_uimm_lo 25:7
%fentry_begin 15:5
%fentry_end 20:5

# FENTRY: Function entry - save registers, adjust SP
fentry        .... .... .... .... .000 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FEXIT: Function exit - restore registers, adjust SP (returns via setc.tgt)
fexit         .... .... .... .... .001 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FRET.RA: Function return via RA - restore registers, adjust SP, return
fret_ra       .... .... .... .... .010 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FRET.STK: Function return via stack - restore registers, adjust SP, return
fret_stk      .... .... .... .... .011 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# PC-relative address instructions (overlap group - setret is specialized addtpc with RegDst=RA)
{
  setret        .... .... .... .... .... 0101 0000 0111 %imm20
  addtpc        .... .... .... .... .... .... .000 0111 %RegDst %imm20
}

# Call/return support
setc_tgt      0000 0000 0000 .... .100 0000 0011 1011 %SrcL

# Predicate/compare
setc_lt       0000 0... .... .... .100 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_ltu      0000 0... .... .... .110 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_ge       0000 0... .... .... .101 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_geu      0000 0... .... .... .111 0000 0110 0101 %SrcL %SrcR %SrcRType

cmp_eq        0000 0... .... .... .000 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_ne        0000 0... .... .... .001 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_and       0000 0... .... .... .010 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_or        0000 0... .... .... .011 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_lt        0000 0... .... .... .100 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_ge        0000 0... .... .... .101 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_ltu       0000 0... .... .... .110 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType
cmp_geu       0000 0... .... .... .111 .... .100 0101 %RegDst %SrcL %SrcR %SrcRType

csel          .... .... .... .... .000 .... .111 0111 %RegDst %SrcL %SrcP %SrcR %SrcRType

# ALU (register)
add           .... .... .... .... .000 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
sub           .... .... .... .... .001 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
and           .... .... .... .... .010 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
or            .... .... .... .... .011 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
xor           .... .... .... .... .100 .... .000 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5

addw          .... .... .... .... .000 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
subw          .... .... .... .... .001 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
andw          .... .... .... .... .010 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
orw           .... .... .... .... .011 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
xorw          .... .... .... .... .100 .... .010 0101 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5

# ALU (immediate)
addi          .... .... .... .... .000 .... .001 0101 %RegDst %SrcL %uimm12
subi          .... .... .... .... .001 .... .001 0101 %RegDst %SrcL %uimm12
andi          .... .... .... .... .010 .... .001 0101 %RegDst %SrcL simm12=%simm12_20_s12
ori           .... .... .... .... .011 .... .001 0101 %RegDst %SrcL simm12=%simm12_20_s12
xori          .... .... .... .... .100 .... .001 0101 %RegDst %SrcL simm12=%simm12_20_s12

addiw         .... .... .... .... .000 .... .011 0101 %RegDst %SrcL %uimm12
subiw         .... .... .... .... .001 .... .011 0101 %RegDst %SrcL %uimm12
andiw         .... .... .... .... .010 .... .011 0101 %RegDst %SrcL simm12=%simm12_20_s12
oriw          .... .... .... .... .011 .... .011 0101 %RegDst %SrcL simm12=%simm12_20_s12
xoriw         .... .... .... .... .100 .... .011 0101 %RegDst %SrcL simm12=%simm12_20_s12

# Mul/Div/Rem
mul           0000 000. .... .... .000 .... .100 0111 %RegDst %SrcL %SrcR
mulw          0000 000. .... .... .010 .... .100 0111 %RegDst %SrcL %SrcR

div           0000 000. .... .... .000 .... .101 0111 %RegDst %SrcL %SrcR
divu          0000 000. .... .... .001 .... .101 0111 %RegDst %SrcL %SrcR
divw          0000 000. .... .... .010 .... .101 0111 %RegDst %SrcL %SrcR
divuw         0000 000. .... .... .011 .... .101 0111 %RegDst %SrcL %SrcR

rem           0000 000. .... .... .100 .... .101 0111 %RegDst %SrcL %SrcR
remu          0000 000. .... .... .101 .... .101 0111 %RegDst %SrcL %SrcR
remw          0000 000. .... .... .110 .... .101 0111 %RegDst %SrcL %SrcR
remuw         0000 000. .... .... .111 .... .101 0111 %RegDst %SrcL %SrcR

# LUI / constant materialization
lui           .... .... .... .... .... .... .001 0111 %RegDst %imm20

# Shifts (register)
sll           0000 000. .... .... .111 .... .000 0101 %RegDst %SrcL %SrcR
srl           0000 000. .... .... .101 .... .000 0101 %RegDst %SrcL %SrcR
sra           0000 000. .... .... .110 .... .000 0101 %RegDst %SrcL %SrcR

sllw          0000 000. .... .... .111 .... .010 0101 %RegDst %SrcL %SrcR
srlw          0000 000. .... .... .101 .... .010 0101 %RegDst %SrcL %SrcR
sraw          0000 000. .... .... .110 .... .010 0101 %RegDst %SrcL %SrcR

# Shifts (immediate)
slli          0000 00.. .... .... .111 .... .001 0101 %RegDst %SrcL shamt=%shamt_20_6
srli          0000 00.. .... .... .101 .... .001 0101 %RegDst %SrcL shamt=%shamt_20_6
srai          0000 00.. .... .... .110 .... .001 0101 %RegDst %SrcL shamt=%shamt_20_6

slliw         0000 000. .... .... .111 .... .011 0101 %RegDst %SrcL shamt=%shamt_20_5
srliw         0000 000. .... .... .101 .... .011 0101 %RegDst %SrcL shamt=%shamt_20_5
sraiw         0000 000. .... .... .110 .... .011 0101 %RegDst %SrcL shamt=%shamt_20_5

# Loads (immediate offset)
lbi           .... .... .... .... .000 .... .001 1001 %RegDst %SrcL simm12=%simm12_20_s12
lbui          .... .... .... .... .100 .... .001 1001 %RegDst %SrcL simm12=%simm12_20_s12
lhi           .... .... .... .... .001 .... .001 1001 %RegDst %SrcL simm12=%simm12_20_s12
lhui          .... .... .... .... .101 .... .001 1001 %RegDst %SrcL simm12=%simm12_20_s12
lwi           .... .... .... .... .010 .... .001 1001 %RegDst %SrcL simm12=%simm12_20_s12
lwui          .... .... .... .... .110 .... .001 1001 %RegDst %SrcL simm12=%simm12_20_s12
ldi           .... .... .... .... .011 .... .001 1001 %RegDst %SrcL simm12=%simm12_20_s12

# Loads (indexed)
lb            .... .... .... .... .000 .... .000 1001 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
lbu           .... .... .... .... .100 .... .000 1001 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
lh            .... .... .... .... .001 .... .000 1001 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
lhu           .... .... .... .... .101 .... .000 1001 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
lw            .... .... .... .... .010 .... .000 1001 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
lwu           .... .... .... .... .110 .... .000 1001 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5
ld            .... .... .... .... .011 .... .000 1001 %RegDst %SrcL %SrcR %SrcRType shamt=%shamt_27_5

# Stores (immediate offset)
sbi           .... .... .... .... .000 .... .101 1001 %SrcL %SrcR simm12=%simm12_7_s5_25_7
shi           .... .... .... .... .001 .... .101 1001 %SrcL %SrcR simm12=%simm12_7_s5_25_7
swi           .... .... .... .... .010 .... .101 1001 %SrcL %SrcR simm12=%simm12_7_s5_25_7
sdi           .... .... .... .... .011 .... .101 1001 %SrcL %SrcR simm12=%simm12_7_s5_25_7

# Stores (indexed)
sb            .... .... .... .... .000 0000 0100 1001 %SrcD %SrcL %SrcR %SrcRType
sw            .... .... .... .... .010 0000 0100 1001 %SrcD %SrcL %SrcR %SrcRType
sd            .... .... .... .... .011 0000 0100 1001 %SrcD %SrcL %SrcR %SrcRType

# Min/Max
max           0000 000. .... .... .100 .... .101 1011 %RegDst %SrcL %SrcR
maxu          0000 100. .... .... .100 .... .101 1011 %RegDst %SrcL %SrcR
min           0000 000. .... .... .101 .... .101 1011 %RegDst %SrcL %SrcR
minu          0000 100. .... .... .101 .... .101 1011 %RegDst %SrcL %SrcR

# Bit manipulation
clz           .... .... .... .... .101 .... .110 0111 %RegDst %SrcL %imml %imms
ctz           .... .... .... .... .100 .... .110 0111 %RegDst %SrcL %imml %imms
bcnt          .... .... .... .... .110 .... .110 0111 %RegDst %SrcL %imml %imms
rev           .... .... .... .... .111 .... .110 0111 %RegDst %SrcL %imml %immr

# Bit extract/insert
bxs           .... .... .... .... .000 .... .110 0111 %RegDst %SrcL %imml %imms
bxu           .... .... .... .... .001 .... .110 0111 %RegDst %SrcL %imml %imms
bic           .... .... .... .... .010 .... .110 0111 %RegDst %SrcL %imml %imms
bis           .... .... .... .... .011 .... .110 0111 %RegDst %SrcL %imml %imms

# Compare with immediate
cmp_eqi       .... .... .... .... .000 .... .101 0101 %RegDst %SrcL simm12=%simm12_20_s12
cmp_nei       .... .... .... .... .001 .... .101 0101 %RegDst %SrcL simm12=%simm12_20_s12
cmp_andi      .... .... .... .... .010 .... .101 0101 %RegDst %SrcL simm12=%simm12_20_s12
cmp_ori       .... .... .... .... .011 .... .101 0101 %RegDst %SrcL simm12=%simm12_20_s12
cmp_lti       .... .... .... .... .100 .... .101 0101 %RegDst %SrcL simm12=%simm12_20_s12
cmp_gei       .... .... .... .... .101 .... .101 0101 %RegDst %SrcL simm12=%simm12_20_s12
cmp_ltui      .... .... .... .... .110 .... .101 0101 %RegDst %SrcL %uimm12
cmp_geui      .... .... .... .... .111 .... .101 0101 %RegDst %SrcL %uimm12

# Branch instructions (set condition, not direct branches)
b_z           .... .... .... .... .001 .... .011 0111 %simm22
b_nz          .... .... .... .... .010 .... .011 0111 %simm22

# System / debug
ebreak        0000 .... 0001 0000 0001 0000 0010 1011 %imm4
