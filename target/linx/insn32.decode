  bstart_timg2col             .... .110 0100 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tgatherb             .... .110 0001 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tdeinterleave        .... .111 1000 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tinterleave          .... .111 1001 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_treshape             .... .111 0111 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tsort                .... .110 1100 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tmrgsort             .... .110 1101 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_thistogram           .... .110 1000 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tpush                .... .111 1010 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tpop                 .... .111 1011 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_talloc               .... .111 1100 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tfree                .... .111 1101 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tpartadd             .... .111 0001 0001 1001 0001 1000 0001 dtype=%TileDataType
  bstart_tpartmul             .... .111 0010 0001 1001 0001 1000 0001 dtype=%TileDataType
