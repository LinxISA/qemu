  bstart_tpartargmin          .... .111 0110 0001 1001 0001 1000 0001 dtype=%TileDataType
  # Canonical selector form retained for decoders that do not use aliases.
  bstart_tepl               ..... .. ..... 00011 001 00011 000 000 1 dtype=%TileDataType mode=%Mode function=%TileFunc
}
bstop         0000 0000 0000 0000 0000 0000 0000 0001

# Vector block headers (VPAR/VSEQ). These are fall-through blocks that commit at
# (C.)BSTOP or when the next BSTART is encountered.
bstart_vpar 0000 0..0 0000 0010 0001 0001 1000 0001 mode=%Mode
bstart_vseq 0000 0..0 0000 0010 1001 0001 1000 0001 mode=%Mode

# Vector block headers for memory operations (MSEQ/MPAR).
# MSEQ: sequential vector execution with memory access
bstart_mseq 0000 0..0 0000 0000 1001 0001 1000 0001 mode=%Mode
# MPAR: parallel vector execution with memory access
bstart_mpar 0000 0..0 0000 0000 0001 0001 1000 0001 mode=%Mode

# Tile block headers (TMA/CUBE). These are fall-through blocks that commit at
# (C.)BSTOP or when the next BSTART is encountered.
{
  bstart_tload   .... .000 0000 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tstore  .... .000 0001 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmov    .... .000 0010 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tprefetch .... .000 0011 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_mgather .... .000 0100 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_mscatter .... .000 0101 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_mgather_mask .... .000 0110 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_mscatter_mask .... .000 0111 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmov_l2s_insert .... .000 1000 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmov_l2s_publish .... .000 1001 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmov_s2l_broadcast .... .000 1010 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmov_s2l_extract .... .000 1011 0001 0001 0001 1000 0001 dtype=%TileDataType
  bstart_acccvt .... .000 1000 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmul .... .000 0000 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmul_bias .... .000 0001 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmul_acc .... .000 0010 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmulmx .... .000 0100 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmulmx_bias .... .000 0101 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmulmx_acc .... .000 0110 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmul_fixp .... .000 1001 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tmatmul_acc_fixp .... .000 1011 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tgemv .... .001 0000 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tgemv_bias .... .001 0001 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tgemv_acc .... .001 0010 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tgemvmx .... .001 0100 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tgemvmx_bias .... .001 0101 0011 0001 0001 1000 0001 dtype=%TileDataType
  bstart_tgemvmx_acc .... .001 0110 0011 0001 0001 1000 0001 dtype=%TileDataType
}

# DavinciOO PTO ISA v0.2/v5 Tile dependency descriptors.
b_iot          .... .... .... .... .100 .... .001 0011 src0=%IOTV5Src0 src1=%IOTV5Src1 l=%IOTV5Last pe_mask=%IOTV5PeMask tsize=%IOTV5TSize dst=%IOTV5Dst func=4
b_iot          0000 00.. .... .... .101 .... .001 0011 src0=%IOTV5Src0 src1=0 l=%IOTV5Last pe_mask=%IOTV5PeMask tsize=%IOTV5TSize dst=%IOTV5Dst func=5
b_iot          0000 0000 0000 .... .110 .... .001 0011 src0=0 src1=0 l=%IOTV5Last pe_mask=%IOTV5PeMask tsize=%IOTV5TSize dst=%IOTV5Dst func=6

# Decoupled-body pointer (decoupled block headers).
b_text         .... .... .... .... .... .... .000 0011 %simm25

# GPR I/O dependency (decoupled block headers).
b_ior          .... .00. .... .... .000 .... .001 0011 %RegDst %SrcL %SrcR %SrcD

# Tile/tensor layout selector for descriptor-rich TLOAD/TSTORE headers.
b_fpatr      .... .... .... .... .010 0000 0010 0011 pq=%FP_PreQuantMode relu=%FP_ReluMode groupn=%FP_GroupNCode rowmax=%FP_RowMaxEn groupmax=%FP_GroupMaxEn rowinit=%FP_RowMaxInit maxabs=%FP_MaxAbsEn

# Block attributes (ordering/traps); treated as hints/no-ops in bring-up.
b_catr         0000 0.00 0000 .... .000 0000 0010 0011 dr=%BA_DR aq=%BA_aq atom=%BA_atom far=%BA_far rl=%BA_rl trap=%BA_trap
b_datr         .... .... .... 00.. .001 .... .010 0011 cmode=%BA_CMode layout=%BA_DataLayout dtype=%BA_DataType pad=%BA_PadValue rmode=%BA_RMode sat=%BA_Sat canonicalize=%BA_Canonicalize

# Block hints; treated as no-ops in bring-up.
b_hint         .... .... .... 0... .000 0000 0011 0011 l_ul=%HINT_L_UL v=%HINT_V prefetch_size=%HINT_prefetch_size temp=%HINT_temp
b_hint_trace   0000 0000 0000 0000 .001 0000 0011 0011 b_e=%HINT_B_E
# Block argument registers (LB0/LB1/LB2): LBx = RegSrc + uimm17
b_dim_lb0      .... .... .... .... .000 .... .100 0011 reg=%SrcL uimm=%uimm17_20_12_7_5
b_dim_lb1      .... .... .... .... .001 .... .100 0011 reg=%SrcL uimm=%uimm17_20_12_7_5
b_dim_lb2      .... .... .... .... .010 .... .100 0011 reg=%SrcL uimm=%uimm17_20_12_7_5

# SSR access (system registers)
# Encoding (base form): SSR_ID[11:0] in bits [31:20].
ssrget .... .... .... 0000 0000 .... .011 1011 %RegDst ssrid=%ssr_id
ssrset .... .... .... .... .001 0000 0011 1011 %SrcL ssrid=%ssr_id
ssrswap .... .... .... .... .010 .... .011 1011 %RegDst %SrcL ssrid=%ssr_id

# Access Control Ring (ACR) privilege transitions
# acrc rst_type
acrc   0000 0000 .... 0000 0011 0000 0010 1011 rst=%acr_type
# acre rra_type
acre   0000 0001 .... 0000 0011 0000 0010 1011 rra=%acr_type

# Atomics (minimal subset for toolchain intrinsics bring-up)
# Field mapping matches isa/spec: far/aq/rl plus (SrcL/SrcR/RegDst) and funct3.
lr_w   0010 .... .... .... .000 .... .000 1011 %RegDst %SrcL %SrcZero far=%far aq=%aq rl=%rl
lr_d   0011 .... .... .... .000 .... .000 1011 %RegDst %SrcL %SrcZero far=%far aq=%aq rl=%rl
sc_w   0010 .... .... .... .001 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl
sc_d   0011 .... .... .... .001 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl

swapw  0010 .... .... .... .110 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl
swapd  0011 .... .... .... .110 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl

lw_add 0000 .... .... .... .010 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl
ld_add 0000 .... .... .... .100 .... .000 1011 %RegDst %SrcL %SrcR far=%far aq=%aq rl=%rl

# v0.57 local compare-and-swap and DMA encodings.
casb   .... .... .... .... .000 .... .001 1011 %RegDst %SrcL %SrcR %SrcD aq=%aq rl=%rl
cash   .... .... .... .... .001 .... .001 1011 %RegDst %SrcL %SrcR %SrcD aq=%aq rl=%rl
casw   .... .... .... .... .010 .... .001 1011 %RegDst %SrcL %SrcR %SrcD aq=%aq rl=%rl
casd   .... .... .... .... .011 .... .001 1011 %RegDst %SrcL %SrcR %SrcD aq=%aq rl=%rl
dma    0000 000. .... .... .111 0000 0000 1011 %SrcL %SrcR

fence_d 0000 .... .... 0000 0010 0000 0010 1011 pred=%pred_imm succ=%succ_imm
fence_i 0001 0000 0000 0000 0010 0000 0010 1011

# TLB flush (bring-up).
tlb_ia   0000 0000 0000 .... .111 0000 0010 1011 %SrcL
tlb_iv   0000 0000 0001 .... .111 0000 0010 1011 %SrcL
tlb_iav  0000 0000 0010 .... .111 0000 0010 1011 %SrcL
tlb_iall 0000 0000 0011 0000 0111 0000 0010 1011

# Function entry/exit macro instructions (LinxISA spec)
# These encode register range [SrcBegin ~ SrcEnd] and stack size (uimm)
#
# Encoding:
#   bits [6:0] = 0x41 (opcode)
#   bits [11:7] = uimm[14:10] (high 5 bits of stack size / 8)
#   bits [14:12] = type (000=FENTRY, 001=FEXIT, 010=FRET.RA, 011=FRET.STK)
#   bits [19:15] = SrcBegin/DstBegin (start register index)
#   bits [24:20] = SrcEnd/DstEnd (end register index)
#   bits [31:25] = uimm[9:3] (low 7 bits of stack size / 8)
#
# Stack size = uimm (8-byte aligned, uimm[2:0] implicit 0)
# Register range: R[Begin] to R[End], can wrap around R23->R2
%fentry_uimm_hi 7:5
%fentry_uimm_lo 25:7
%fentry_begin 15:5
%fentry_end 20:5

# FENTRY: Function entry - save registers, adjust SP
fentry        .... .... .... .... .000 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FEXIT: Function exit - restore registers, adjust SP (returns via setc.tgt)
fexit         .... .... .... .... .001 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FRET.RA: Function return via RA - restore registers, adjust SP, return
fret_ra       .... .... .... .... .010 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# FRET.STK: Function return via stack - restore registers, adjust SP, return
fret_stk      .... .... .... .... .011 .... .100 0001 uimm_hi=%fentry_uimm_hi uimm_lo=%fentry_uimm_lo reg_begin=%fentry_begin reg_end=%fentry_end

# Bulk memory template blocks (restartable).
# Encoding per spec:
#   MCOPY: RegSrc0=DstAddr (bits 19..15), RegSrc1=SrcAddr (24..20), RegSrc2=Size (31..27)
#   MSET:  RegSrc0=DstAddr (bits 19..15), RegSrc1=Value   (24..20), RegSrc2=Size (31..27)
# These are standalone template blocks (must not appear inside BSTART..BSTOP).
mcopy         .... .00. .... .... .000 0000 0011 0001 %SrcL %SrcR %SrcD
mset          .... .00. .... .... .001 0000 0011 0001 %SrcL %SrcR %SrcD
esave         .... .00. .... .... .010 0000 0011 0001 %SrcL %SrcR %SrcD
ercov         .... .00. .... .... .011 0000 0011 0001 %SrcL %SrcR %SrcD

# PC-relative address instructions (overlap group - setret is specialized addtpc with RegDst=RA)
{
  setret        .... .... .... .... .... 0101 0000 0111 %imm20
  addtpc        .... .... .... .... .... .... .000 0111 %RegDst %imm20
}

# Call/return support
setc_tgt      0000 0000 0000 .... .100 0000 0011 1011 %SrcL

# Predicate/compare
setc_eq       0000 0... .... .... .000 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_eqi      .... .... .... .... .000 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_ne       0000 0... .... .... .001 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_nei      .... .... .... .... .001 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
setc_and      0000 0... .... .... .010 0000 0110 0101 %SrcL %SrcR %SrcRType
setc_andi     .... .... .... .... .010 .... .111 0101 %SrcL simm12=%simm12_20_s12 shamt=%RegDst
