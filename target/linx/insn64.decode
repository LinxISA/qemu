#
# LinxISA 64-bit (V.*) instruction decoding
#
# This file contains the current 64-bit VEC instruction subset used by
# canonical v0.4 MSEQ/MPAR body decoding in QEMU.
#

# 10-bit vector register codes are split across the two 32-bit halves:
#   hi bits in the low 32-bit word, lo bits in the high 32-bit word.
#
# Full 10-bit code = (class << 5) | index
#

# Fields
%RegDst 7:5 39:5
%SrcL 15:5 47:5
%SrcR 20:5 52:5
%SrcD 27:5 59:5
%SrcRType 57:2
%shamt_hi 59:5
%shamt_lo 7:5
%C 12:1
%L 14:1

# ---------------------------------------------------------------------------
# Arithmetic
# ---------------------------------------------------------------------------

# V.ADD
v_add .... .... .... .... .000 .... .000 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR srctype=%SrcRType shamt=%shamt_hi

# V.SUB
v_sub .... .... .... .... .001 .... .000 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR srctype=%SrcRType shamt=%shamt_hi

# V.MUL
v_mul .... .... .... .... .000 .... .100 0111 0000 000. .... .... ..0. .... .111 1111 %RegDst %SrcL %SrcR srctype=%SrcRType shamt=%shamt_hi c=%C l=%L

# V.CMP.{EQ,NE,LT,LTU,GE,GEU}
v_cmp_eq  0000 000. .... .... .000 .... .100 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_cmp_ne  0000 000. .... .... .001 .... .100 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_cmp_lt  0000 000. .... .... .100 .... .100 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_cmp_ltu 0000 000. .... .... .110 .... .100 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_cmp_ge  0000 000. .... .... .101 .... .100 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_cmp_geu 0000 000. .... .... .111 .... .100 0101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR

# V.F{EQ,NE,LT,GE}
v_feq 0000 000. .... .... .000 .... .101 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_fne 0000 000. .... .... .001 .... .101 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_flt 0000 000. .... .... .010 .... .101 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_fge 0000 000. .... .... .011 .... .101 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR

# V.CSEL (SrcD field carries predicate source register code).
v_csel .... .... .... .... .000 .... .111 0111 .... .00. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcD %SrcR srctype=%SrcRType

# V.FADD / V.FSUB / V.FMUL / V.FDIV (float32 bring-up subset)
v_fadd 0000 000. .... .... .000 .... .100 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_fsub 0000 000. .... .... .001 .... .100 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_fmul 0000 000. .... .... .010 .... .100 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR
v_fdiv 0000 000. .... .... .011 .... .100 1011 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR

# V.FABS (float32 abs, unary)
v_fabs .... .... .... .... .000 .... .111 1011 0000 000. .... .... ..0. .... .111 1111 %RegDst %SrcL %SrcR srctype=%SrcRType shamt=%shamt_hi c=%C l=%L

# V.RD* reductions (vector source -> scalar destination register)
v_rdadd  0000 0000 0000 .... .000 .... .000 1101 0000 0000 0000 .... .000 .... .111 1111 %RegDst %SrcL
v_rdand  0000 0000 0000 .... .001 .... .000 1101 0000 0000 0000 .... .000 .... .111 1111 %RegDst %SrcL
v_rdfadd 0000 0000 0000 .... .100 .... .000 1101 0000 0000 0000 .... .000 .... .111 1111 %RegDst %SrcL
v_rdor   0000 0000 0000 .... .010 .... .000 1101 0000 0000 0000 .... .000 .... .111 1111 %RegDst %SrcL
v_rdxor  0000 0000 0000 .... .011 .... .000 1101 0000 0000 0000 .... .000 .... .111 1111 %RegDst %SrcL
v_rdmax  0000 0000 0000 .... .000 .... .000 1101 0000 0000 0000 .... .001 .... .111 1111 %RegDst %SrcL
v_rdmin  0000 0000 0000 .... .001 .... .000 1101 0000 0000 0000 .... .001 .... .111 1111 %RegDst %SrcL
v_rdfmax 0000 0000 0000 .... .010 .... .000 1101 0000 0000 0000 .... .001 .... .111 1111 %RegDst %SrcL
v_rdfmin 0000 0000 0000 .... .011 .... .000 1101 0000 0000 0000 .... .001 .... .111 1111 %RegDst %SrcL

# ---------------------------------------------------------------------------
# Stores (bridged)
# ---------------------------------------------------------------------------

# V.LW / V.LW.BRG (word loads; `.local` uses tile bases, `.brg` uses RI bases)
v_lw     .... .00. .... .... .010 .... .000 1001 0000 000. .... .... ..0. .... .111 1111 %RegDst %SrcL %SrcR shamt=%shamt_hi c=%C l=%L
v_lw_brg .... .00. .... .... .010 .... .000 1001 0000 000. .... .... ..1. .... .111 1111 %RegDst %SrcL %SrcR shamt=%shamt_hi c=%C l=%L

# V.SW.BRG
v_sw_brg .... .00. .... .... .010 0000 0100 1001 .... .00. .... .... ..1. .... .111 1111 %SrcD %SrcL %SrcR shamt=%shamt_lo c=%C l=%L

# V.SW (local/tile direction; `.local` uses tile bases)
v_sw     .... .00. .... .... .010 0000 0100 1001 .... .00. .... .... ..0. .... .111 1111 %SrcD %SrcL %SrcR shamt=%shamt_lo c=%C l=%L
