#
# LinxISA 64-bit (V.*) instruction decoding
#
# This file contains the current 64-bit VEC instruction subset used by
# canonical v0.4 MSEQ/MPAR body decoding in QEMU.
#

# 10-bit vector register codes are split across the two 32-bit halves:
#   hi bits in the low 32-bit word, lo bits in the high 32-bit word.
#
# Full 10-bit code = (class << 5) | index
#

# Fields
%RegDst 7:5 39:5
%SrcL 15:5 47:5
%SrcR 20:5 52:5
%SrcD 27:5 59:5
%SrcP 27:5 59:5
%SrcA 27:5 59:5
%SrcRType 57:2
%DstType 59:5
%SrcType 52:5
%uimm12 52:12
%simm12 52:s12
%simm42_7_s25_47_17 7:s25 47:17
%imml 52:6
%imms 58:6
%shamt6 52:6
%shamt_hi 59:5
%shamt_lo 7:5
%C 12:1
%L 14:1
%VRawImm24 7:6 14:18 39:5 47:17
%VRawIndexed 7:6 14:11 39:5 47:10 59:5
%VRawAtomicLoad 7:5 15:11 39:5 47:12
%VRawIndexedStore 7:6 14:11 27:5 47:10 59:5
%VRawAtomicStore 15:12 47:11
%VRawShuffleBfly 7:5 15:5 27:5 39:5 47:5 59:5
%VRawShuffle 7:5 15:10 27:5 39:5 47:10 59:5
%VRawShuffleIBfly 7:5 15:5 25:7 39:5 47:5 57:7
%VRawShuffleI 7:5 15:17 39:5 47:17

# ---------------------------------------------------------------------------
# Arithmetic
# ---------------------------------------------------------------------------

# Queue manager operations.  These are the canonical 64-bit V.* forms; the
# similarly named HL.* encodings remain separate 48-bit instructions.
v_qpop  0000 0000 0000 .... .010 .... .111 1101 0000 0000 0000 .... .000 .... .111 1111 %RegDst %SrcL
v_qpush 0000 000. .... .... .001 .... .111 1101 0000 000. .... .... .000 .... .111 1111 %RegDst %SrcL %SrcR

# 64-bit scalar block headers (L.BSTART.* with 42-bit halfword-scaled target)
l_bstop             0000 0000 0000 0000 0000 0000 0000 0001 0000 0000 0000 0000 0000 0000 0000 1111
l_bstart_std        .... .... .... .... .001 0000 0000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_std        .... .... .... .... .010 0000 0000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_std        .... .... .... .... .011 0000 0000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_std        .... .... .... .... .100 0000 0000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_fp         .... .... .... .... .001 0000 1000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_fp         .... .... .... .... .010 0000 1000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_fp         .... .... .... .... .011 0000 1000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_fp         .... .... .... .... .100 0000 1000 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17
l_bstart_sys        .... .... .... .... .001 0000 0001 0001 .... .... .... .... .... .... .000 1111 simm=%simm42_7_s25_47_17

